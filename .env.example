# OpenAI-compatible endpoint used by CodeWikiBench judges and rubric generation.
# Copy to .env and fill in. `.env` is gitignored.
BASE_URL=https://api.example.com/v1
API_KEY=sk-...
MODEL=claude-sonnet-4

# Pin a HuggingFace dataset revision/commit for reproducible `prepare --from-hf`.
# REPODOC_DATASET_REVISION=main

# Optional embedding model used by some CodeWikiBench rubric utilities.
# EMBEDDING_MODEL=gemini-embedding-001

# Python used to run the CodeWikiBench CLI (optional; defaults to the harness interpreter).
# REPODOC_BENCH_PYTHON=/path/to/RepoDoc/.venv/bin/python

# CodeWiki binary (optional; configs/systems.yaml already points at the dedicated venv).
# CODEWIKI_BIN=/path/to/RepoDoc/.venv-codewiki/bin/codewiki

# Optional GitHub token for the Web UI repository search (raises API limits).
# GITHUB_TOKEN=ghp_...

# ---------------------------------------------------------------------------
# Our method: OpenCode Go (independent of CodeWikiBench's BASE_URL/API_KEY)
# ---------------------------------------------------------------------------
# Go chat-completions endpoint; deepseek-v4.1-flash is the default model.
OPENCODE_GO_API_KEY=oc_sk_...
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1/
OPENCODE_GO_MODEL=deepseek-v4.1-flash
# Stable per-conversation/run session; set it for reproducible prompt-cache/routing.
# OPENCODE_GO_SESSION=repodoc-local
# OPENCODE_GO_ENV_FILE=/abs/path/to/.env
OPENCODE_GO_USER_AGENT=repodoc-ours/0.1
# OPENCODE_GO_TIMEOUT=120
# OPENCODE_GO_MAX_TOKENS=8192

# Optional RepoDoc Q&A dense retrieval (fastembed/ONNX, no torch).
# REPODOC_DENSE=1
# REPODOC_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Dynamic budgets: ratios of the model's catalog limits (primary policy).
# REPODOC_CLUSTER_CONTEXT_RATIO=0.02
# REPODOC_CLUSTER_OUTPUT_RATIO=0.02
# REPODOC_DOC_CONTEXT_RATIO=0.04
# REPODOC_DOC_OUTPUT_RATIO=0.05
# Fallback only when the model catalog cannot be fetched:
# OPENCODE_GO_CONTEXT_LIMIT=200000
# OPENCODE_GO_OUTPUT_LIMIT=32768
